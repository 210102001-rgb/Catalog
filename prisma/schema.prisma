generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int            @id @default(autoincrement())
  uuid                   String         @unique @db.VarChar(36)
  name                   String         @db.VarChar(100)
  email                  String         @unique @db.VarChar(255)
  password_hash          String?        @db.VarChar(255)
  role                   UserRole       @default(CUSTOMER)
  user_type              UserType       @default(INDIVIDUAL)
  company_name           String?        @db.VarChar(255)
  phone                  String?        @db.VarChar(20)
  address                String?        @db.Text
  city                   String?        @db.VarChar(100)
  postal_code            String?        @db.VarChar(20)
  status                 UserStatus     @default(PENDING_VERIFICATION)
  email_verified         Boolean        @default(false)
  email_verified_at      DateTime?
  npwp_verified          Boolean        @default(false)
  npwp_valid_until       DateTime?
  balance                Decimal        @default(0.00) @db.Decimal(15, 2)
  points                 Int            @default(0)
  last_login_at          DateTime?
  last_login_ip          String?
  remember_token         String?
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
  deleted_at             DateTime?
  cart_items             CartItem[]
  receivedChats          Chat[]         @relation("ChatReceiver")
  createdChats           Chat[]         @relation("ChatSender")
  customer_data          CustomerData[]
  verified_customer_data CustomerData[] @relation("CustomerDataVerifier")
  favorites              Favorite[]
  notifications          Notification[]
  handled_orders         Order[]        @relation("OrderAdmin")
  orders                 Order[]        @relation("OrderCustomer")
  approved_products      Product[]      @relation("ApproverProduct")
  products               Product[]      @relation("ProductCreator")
  reported_reports       Report[]       @relation("ReportReporter")
  resolved_reports       Report[]       @relation("ReportResolver")
  reviews                Review[]

  @@index([email], map: "idx_users_email")
  @@index([status], map: "idx_users_status")
  @@index([role], map: "idx_users_role")
  @@index([deleted_at], map: "idx_users_deleted_at")
  @@map("users")
}

model Product {
  id                  Int                @id @default(autoincrement())
  uuid                String             @unique @db.VarChar(36)
  name                String             @db.VarChar(255)
  slug                String             @unique @db.VarChar(255)
  description         String?            @db.Text
  category_id         Int?
  subcategory_id      Int?
  location            String             @db.VarChar(255)
  latitude            Float?
  longitude           Float?
  size_width          Int?
  size_height         Int?
  illumination        Boolean            @default(false)
  visibility          VisibilityType     @default(DAYTIME)
  price_daily         Decimal            @db.Decimal(15, 2)
  price_weekly        Decimal            @db.Decimal(15, 2)
  price_monthly       Decimal            @db.Decimal(15, 2)
  price_yearly        Decimal            @db.Decimal(15, 2)
  availability_status AvailabilityStatus @default(AVAILABLE)
  stock_quantity      Int                @default(1)
  images              Json?
  specifications      Json?
  rating              Float              @default(0)
  review_count        Int                @default(0)
  featured            Boolean            @default(false)
  published           Boolean            @default(false)
  created_by          Int
  approved_by         Int?
  approved_at         DateTime?
  status              ProductStatus      @default(DRAFT)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  deleted_at          DateTime?
  carts               CartItem[]
  favorites           Favorite[]
  orders              OrderItem[]
  approver            User?              @relation("ApproverProduct", fields: [approved_by], references: [id])
  category            Category?          @relation(fields: [category_id], references: [id])
  creator             User               @relation("ProductCreator", fields: [created_by], references: [id])
  subcategory         SubCategory?       @relation(fields: [subcategory_id], references: [id])
  reviews             Review[]

  @@index([created_by], map: "idx_products_created_by")
  @@index([category_id], map: "idx_products_category")
  @@index([subcategory_id], map: "idx_products_subcategory")
  @@index([location], map: "idx_products_location")
  @@index([availability_status], map: "idx_products_availability")
  @@index([published], map: "idx_products_published")
  @@index([deleted_at], map: "idx_products_deleted_at")
  @@index([approved_by], map: "products_approved_by_fkey")
  @@map("products")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(100)
  slug          String        @unique @db.VarChar(100)
  description   String?       @db.Text
  image         String?       @db.VarChar(255)
  parent_id     Int?
  level         Int           @default(0)
  order         Int           @default(0)
  active        Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  parent        Category?     @relation("CategoryTree", fields: [parent_id], references: [id])
  children      Category[]    @relation("CategoryTree")
  products      Product[]
  subcategories SubCategory[]

  @@index([parent_id], map: "idx_categories_parent")
  @@index([active], map: "idx_categories_active")
  @@map("categories")
}

model SubCategory {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  category_id Int
  image       String?   @db.VarChar(255)
  order       Int       @default(0)
  active      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  products    Product[]
  category    Category  @relation(fields: [category_id], references: [id])

  @@index([category_id], map: "idx_subcategories_category")
  @@index([active], map: "idx_subcategories_active")
  @@map("subcategories")
}

model Order {
  id                  Int            @id @default(autoincrement())
  uuid                String         @unique @db.VarChar(36)
  order_number        String         @unique @db.VarChar(50)
  user_id             Int
  admin_id            Int?
  total_amount        Decimal        @db.Decimal(15, 2)
  tax_amount          Decimal        @default(0.00) @db.Decimal(15, 2)
  discount_amount     Decimal        @default(0.00) @db.Decimal(15, 2)
  final_amount        Decimal        @db.Decimal(15, 2)
  currency            String         @default("IDR") @db.VarChar(3)
  status              OrderStatus    @default(PENDING)
  payment_method      PaymentMethod?
  payment_status      PaymentStatus  @default(PENDING)
  payment_date        DateTime?
  start_date          DateTime
  end_date            DateTime
  notes               String?        @db.Text
  shipping_address    String?        @db.Text
  billing_address     String?        @db.Text
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  deleted_at          DateTime?
  order_notifications Notification[] @relation("OrderNotifications")
  order_items         OrderItem[]
  admin               User?          @relation("OrderAdmin", fields: [admin_id], references: [id])
  user                User           @relation("OrderCustomer", fields: [user_id], references: [id])
  payments            Payment[]
  reviews             Review[]

  @@index([user_id], map: "idx_orders_user")
  @@index([admin_id], map: "idx_orders_admin")
  @@index([order_number], map: "idx_orders_number")
  @@index([status], map: "idx_orders_status")
  @@index([payment_status], map: "idx_orders_payment_status")
  @@index([created_at], map: "idx_orders_created_at")
  @@index([deleted_at], map: "idx_orders_deleted_at")
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  order_id    Int
  product_id  Int
  quantity    Int      @default(1)
  unit_price  Decimal  @db.Decimal(15, 2)
  total_price Decimal  @db.Decimal(15, 2)
  start_date  DateTime
  end_date    DateTime
  created_at  DateTime @default(now())
  order       Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [product_id], references: [id])

  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "idx_order_items_product")
  @@map("order_items")
}

model Payment {
  id               Int           @id @default(autoincrement())
  uuid             String        @unique @db.VarChar(36)
  order_id         Int
  amount           Decimal       @db.Decimal(15, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  transaction_id   String?       @db.VarChar(255)
  gateway_response Json?
  notes            String?       @db.Text
  paid_at          DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  order            Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id], map: "idx_payments_order")
  @@index([transaction_id], map: "idx_payments_transaction")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

model CartItem {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  quantity   Int      @default(1)
  start_date DateTime
  end_date   DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_cart_items_user")
  @@index([product_id], map: "idx_cart_items_product")
  @@map("cart_items")
}

model Favorite {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now())
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id], name: "unique_user_product_favorite")
  @@index([user_id], map: "idx_favorites_user")
  @@index([product_id], map: "idx_favorites_product")
  @@map("favorites")
}

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  order_id   Int?
  rating     Int      @default(0) @db.TinyInt
  title      String?  @db.VarChar(255)
  comment    String?  @db.Text
  images     Json?
  verified   Boolean  @default(false)
  helpful    Int      @default(0)
  reported   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  order      Order?   @relation(fields: [order_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id], name: "unique_user_product_review")
  @@index([user_id], map: "idx_reviews_user")
  @@index([product_id], map: "idx_reviews_product")
  @@index([rating], map: "idx_reviews_rating")
  @@index([order_id], map: "reviews_order_id_fkey")
  @@map("reviews")
}

model Chat {
  id          Int         @id @default(autoincrement())
  sender_id   Int
  receiver_id Int
  message     String      @db.Text
  type        MessageType @default(TEXT)
  read        Boolean     @default(false)
  read_at     DateTime?
  created_at  DateTime    @default(now())
  receiver    User        @relation("ChatReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  sender      User        @relation("ChatSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([sender_id], map: "idx_chats_sender")
  @@index([receiver_id], map: "idx_chats_receiver")
  @@index([created_at], map: "idx_chats_created_at")
  @@index([read], map: "idx_chats_read")
  @@map("chats")
}

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int
  order_id   Int?
  title      String           @db.VarChar(255)
  message    String           @db.Text
  type       NotificationType
  data       Json?
  read       Boolean          @default(false)
  read_at    DateTime?
  created_at DateTime         @default(now())
  order      Order?           @relation("OrderNotifications", fields: [order_id], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_notifications_user")
  @@index([order_id], map: "idx_notifications_order")
  @@index([type], map: "idx_notifications_type")
  @@index([read], map: "idx_notifications_read")
  @@index([created_at], map: "idx_notifications_created_at")
  @@map("notifications")
}

model CustomerData {
  id                  Int                @id @default(autoincrement())
  user_id             Int
  company_name        String?            @db.VarChar(255)
  company_address     String?            @db.Text
  company_phone       String?            @db.VarChar(20)
  npwp_number         String?            @db.VarChar(50)
  npwp_file           String?            @db.VarChar(255)
  ktp_number          String?            @db.VarChar(50)
  ktp_file            String?            @db.VarChar(255)
  bank_account        String?            @db.VarChar(50)
  bank_name           String?            @db.VarChar(100)
  verification_status VerificationStatus @default(PENDING)
  verified_by         Int?
  verified_at         DateTime?
  rejected_reason     String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  verifier            User?              @relation("CustomerDataVerifier", fields: [verified_by], references: [id])

  @@index([user_id], map: "idx_customer_data_user")
  @@index([npwp_number], map: "idx_customer_data_npwp")
  @@index([verification_status], map: "idx_customer_data_verification")
  @@index([verified_by], map: "customer_data_verified_by_fkey")
  @@map("customer_data")
}

model Report {
  id              Int          @id @default(autoincrement())
  reporter_id     Int
  resolved_by     Int?
  reported_type   ReportedType
  reported_id     Int
  reason          String       @db.Text
  description     String?      @db.Text
  status          ReportStatus @default(PENDING)
  resolved_at     DateTime?
  resolution_note String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  reporter        User         @relation("ReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  resolver        User?        @relation("ReportResolver", fields: [resolved_by], references: [id])

  @@index([reporter_id], map: "idx_reports_reporter")
  @@index([reported_type, reported_id], map: "idx_reports_target")
  @@index([status], map: "idx_reports_status")
  @@index([created_at], map: "idx_reports_created_at")
  @@index([resolved_by], map: "reports_resolved_by_fkey")
  @@map("reports")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserType {
  INDIVIDUAL
  COMPANY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VisibilityType {
  DAYTIME
  NIGHTTIME
  ALWAYSON
}

enum AvailabilityStatus {
  AVAILABLE
  RESERVED
  MAINTENANCE
  UNAVAILABLE
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  E_WALLET
  VOUCHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  ORDER_UPDATE
  SYSTEM
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT_STATUS
  PRODUCT_UPDATE
  PROMOTION
  CHAT_MESSAGE
  SYSTEM_ALERT
  REVIEW_REPLY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportedType {
  USER
  PRODUCT
  REVIEW
  CHAT
  ORDER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}
